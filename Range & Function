# Problem 1 - Range and Break/Continue

print("Multiples of 7:", end=" ")
for number in range(7, 101, 7):
    print(number, end=" ")
print()

print("Not divisible by 3:", end=" ")
for number in range(1, 21):
    if number % 3 == 0:
        continue
    print(number, end=" ")
print()

correct_password = "python123"

while True:
    password = input("Enter password: ")
    if password == correct_password:
        print("Access granted!")
        break
    print("Incorrect password, try again.")


# Problem 2 - Nested Loops

print("\nMultiplication table:")
for row in range(1, 6):
    for column in range(1, 6):
        print(f"{row * column:>4}", end="")
    print()

rows = int(input("\nHow many rows for the triangle? "))

print("Triangle:")
for row in range(1, rows + 1):
    for column in range(row):
        print("*", end="")
    print()


# Problem 3 - Incremental Development

score_count = int(input("\nHow many quiz scores? "))

if score_count > 0:
    scores = []

    for score_number in range(1, score_count + 1):
        score = int(input(f"Enter score {score_number}: "))
        scores.append(score)

    total = sum(scores)
    average = total / score_count

    print(f"Total: {total}")
    print(f"Average: {average}")
    print(f"Highest: {max(scores)}")
    print(f"Lowest: {min(scores)}")
else:
    print("Please enter at least one quiz score.")
